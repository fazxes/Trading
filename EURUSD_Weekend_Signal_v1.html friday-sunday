          <button class="sess-btn" id="sess-sun" onclick="setSession('sun',this)">
            <span class="day">SUN</span>All Day<br><span class="time">00:00 – 21:00</span>
          </button>
        </div>
        <div id="session-note" style="font-family:'Share Tech Mono',monospace;font-size:10px;color:var(--muted);line-height:1.7;border-top:1px solid var(--border);padding-top:10px;">
