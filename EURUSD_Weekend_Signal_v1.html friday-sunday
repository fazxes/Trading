<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>EUR/USD OTC · WEEKEND SIGNAL ENGINE</title>
<style>
  @import url('https://fonts.googleapis.com/css2?family=Share+Tech+Mono&family=Orbitron:wght@400;700;900&family=Rajdhani:wght@400;600;700&display=swap');
  :root {
    --bg:#06040a; --panel:#0d0815; --border:#2a1040; --border2:#160828;
    --buy:#00e5a0; --sell:#ff3d6b; --skip:#f0a500; --block:#ff2222;
    --accent:#b060ff; --accent2:#7c3aed; --muted:#5a3a7a; --text:#c8b8e8; --dim:#2a1548;
    --warn:#ff9500; --trap:#ff2d55;
  }
  *{box-sizing:border-box;margin:0;padding:0;}
  body{background:var(--bg);color:var(--text);font-family:'Rajdhani',sans-serif;min-height:100vh;}
  body::before{content:'';position:fixed;inset:0;
    background:
      radial-gradient(ellipse 50% 30% at 80% 5%, #2a004a18 0%, transparent 60%),
      radial-gradient(ellipse 40% 40% at 10% 90%, #1a003a12 0%, transparent 60%),
      repeating-linear-gradient(0deg,transparent,transparent 39px,#2a104008 40px),
      repeating-linear-gradient(90deg,transparent,transparent 39px,#2a104008 40px);
    pointer-events:none;z-index:0;}
  .wrap{position:relative;z-index:1;max-width:1400px;margin:0 auto;padding:20px 16px 60px;}

  /* HEADER */
  .header{text-align:center;padding:26px 0 20px;border-bottom:1px solid var(--border);margin-bottom:22px;}
  .badge{display:inline-block;font-family:'Share Tech Mono',monospace;font-size:10px;letter-spacing:4px;
    color:var(--accent);background:#b060ff12;border:1px solid #b060ff28;padding:4px 16px;margin-bottom:10px;}
  .weekend-tag{display:inline-block;font-family:'Share Tech Mono',monospace;font-size:9px;letter-spacing:3px;
    color:var(--warn);background:#ff950012;border:1px solid #ff950030;padding:3px 12px;margin-left:10px;vertical-align:middle;}
  h1{font-family:'Orbitron',monospace;font-size:clamp(16px,3vw,30px);font-weight:900;color:#fff;
    letter-spacing:2px;text-shadow:0 0 30px #b060ff50;}
  h1 span{color:var(--accent);}
  .sub{font-family:'Share Tech Mono',monospace;font-size:11px;color:var(--muted);margin-top:7px;letter-spacing:2px;}

  /* WARNING BANNER */
  .weekend-banner{
    background:#150820;border:1px solid #ff950030;border-left:3px solid var(--warn);
    padding:12px 18px;margin-bottom:20px;font-family:'Share Tech Mono',monospace;font-size:11px;
    color:var(--warn);line-height:1.8;
  }
  .weekend-banner strong{color:#ffb340;}

  /* LAYOUT */
  .main-grid{display:grid;grid-template-columns:360px 1fr;gap:20px;}
  @media(max-width:900px){.main-grid{grid-template-columns:1fr;}}

  /* PANELS */
  .panel{background:var(--panel);border:1px solid var(--border);padding:18px;margin-bottom:16px;}
  .ptitle{font-family:'Orbitron',monospace;font-size:10px;letter-spacing:3px;color:var(--accent);
    margin-bottom:13px;display:flex;align-items:center;gap:10px;}
  .ptitle::after{content:'';flex:1;height:1px;background:var(--border);}

  /* SESSION SELECTOR */
  .session-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-bottom:14px;}
  .sess-btn{
    font-family:'Share Tech Mono',monospace;font-size:10px;letter-spacing:1px;
    padding:10px 6px;background:#0a0614;border:1px solid var(--border);
    color:var(--muted);cursor:pointer;transition:all 0.2s;text-align:center;
  }
  .sess-btn:hover{border-color:var(--accent);color:var(--accent);}
  .sess-btn.active{background:#2a104020;border-color:var(--accent);color:var(--accent);box-shadow:0 0 10px #b060ff20;}
  .sess-btn .day{font-family:'Orbitron',monospace;font-size:12px;font-weight:700;display:block;margin-bottom:3px;}
  .sess-btn .time{font-size:9px;color:var(--muted);}
  .sess-btn.active .time{color:#b060ff80;}

  /* INPUT */
  textarea.bulk{width:100%;background:#08040f;border:1px solid var(--border);
    color:#ddc8ff;font-family:'Share Tech Mono',monospace;font-size:12px;
    padding:12px;outline:none;resize:vertical;min-height:240px;line-height:1.85;transition:border-color 0.2s;}
  textarea.bulk:focus{border-color:var(--accent);}
  .hint{font-family:'Share Tech Mono',monospace;font-size:10px;color:var(--muted);margin-top:7px;line-height:1.8;}
  .btn-main{font-family:'Orbitron',monospace;font-size:12px;letter-spacing:2px;padding:13px;
    background:linear-gradient(135deg,#7c3aed,#b060ff);border:none;color:#fff;
    font-weight:700;cursor:pointer;width:100%;margin-top:10px;transition:all 0.2s;}
  .btn-main:hover{filter:brightness(1.15);box-shadow:0 0 20px #b060ff40;}
  .btn-sec{font-family:'Share Tech Mono',monospace;font-size:11px;padding:8px 14px;
    background:transparent;border:1px solid var(--border);color:var(--muted);
    cursor:pointer;transition:all 0.2s;margin-top:7px;width:100%;}
  .btn-sec:hover{border-color:var(--accent);color:var(--accent);}

  /* BIG SIGNAL */
  .signal-mega{
    border:2px solid var(--border);background:#08040f;
    padding:28px 24px;text-align:center;margin-bottom:16px;
    position:relative;overflow:hidden;transition:border-color 0.4s,box-shadow 0.4s;
  }
  .signal-mega.BUY{border-color:var(--buy);box-shadow:0 0 40px #00e5a028;}
  .signal-mega.SELL{border-color:var(--sell);box-shadow:0 0 40px #ff3d6b28;}
  .signal-mega.SKIP{border-color:var(--skip);}
  .signal-mega.BLOCK{border-color:var(--block);box-shadow:0 0 40px #ff222228;}
  .signal-mega.TRAP{border-color:var(--trap);box-shadow:0 0 40px #ff2d5540;animation:trapPulse 1s infinite alternate;}
  @keyframes trapPulse{from{box-shadow:0 0 20px #ff2d5530;}to{box-shadow:0 0 60px #ff2d5560;}}
  .signal-word{font-family:'Orbitron',monospace;font-size:clamp(22px,4.5vw,46px);font-weight:900;
    letter-spacing:4px;line-height:1;}
  .signal-word.BUY{color:var(--buy);text-shadow:0 0 30px #00e5a060;}
  .signal-word.SELL{color:var(--sell);text-shadow:0 0 30px #ff3d6b60;}
  .signal-word.SKIP{color:var(--skip);}
  .signal-word.BLOCK{color:var(--block);text-shadow:0 0 30px #ff222260;}
  .signal-word.TRAP{color:var(--trap);text-shadow:0 0 30px #ff2d5560;}
  .signal-sub{font-family:'Share Tech Mono',monospace;font-size:11px;color:var(--muted);margin-top:8px;letter-spacing:2px;}
  .conf-bar-wrap{margin:14px 0 4px;}
  .conf-label{font-family:'Share Tech Mono',monospace;font-size:10px;color:var(--muted);
    letter-spacing:2px;margin-bottom:6px;display:flex;justify-content:space-between;}
  .conf-bar-bg{height:8px;background:var(--dim);overflow:hidden;}
  .conf-bar-fill{height:100%;width:0%;transition:width 0.6s ease;}
  .conf-bar-fill.BUY{background:linear-gradient(90deg,#00b4d8,#00e5a0);}
  .conf-bar-fill.SELL{background:linear-gradient(90deg,#ff3d6b,#ff7090);}
  .conf-bar-fill.SKIP{background:var(--skip);}
  .conf-bar-fill.BLOCK,.conf-bar-fill.TRAP{background:var(--block);}

  /* MANIPULATION SCORE */
  .manip-box{
    border:1px solid #ff2d5540;background:#150010;padding:14px 16px;margin-bottom:16px;
  }
  .manip-title{font-family:'Orbitron',monospace;font-size:10px;letter-spacing:3px;color:var(--trap);margin-bottom:10px;}
  .manip-meter{display:flex;align-items:center;gap:12px;margin-bottom:8px;}
  .manip-bar-bg{flex:1;height:10px;background:var(--dim);overflow:hidden;}
  .manip-bar-fill{height:100%;transition:width 0.6s;background:linear-gradient(90deg,#f0a500,#ff2d55);}
  .manip-score-num{font-family:'Orbitron',monospace;font-size:18px;font-weight:700;color:var(--trap);min-width:40px;text-align:right;}
  .manip-label{font-family:'Share Tech Mono',monospace;font-size:10px;color:var(--muted);}
  .manip-items{display:grid;grid-template-columns:repeat(2,1fr);gap:6px;}
  .manip-item{background:#0a0010;border:1px solid var(--border2);padding:7px 10px;font-family:'Share Tech Mono',monospace;font-size:10px;}
  .manip-item.detected{border-color:#ff2d5540;color:var(--trap);}
  .manip-item.clear{color:var(--muted);}

  /* SCORE CARDS */
  .score-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:8px;margin-bottom:16px;}
  .score-card{background:#08040f;border:1px solid var(--border);padding:12px 14px;}
  .sc-label{font-family:'Share Tech Mono',monospace;font-size:9px;color:var(--muted);letter-spacing:1px;margin-bottom:4px;}
  .sc-val{font-family:'Orbitron',monospace;font-size:19px;font-weight:700;color:#fff;}
  .sc-val.green{color:var(--buy);}
  .sc-val.red{color:var(--sell);}
  .sc-val.yellow{color:var(--skip);}
  .sc-val.purple{color:var(--accent);}
  .sc-note{font-family:'Share Tech Mono',monospace;font-size:10px;color:var(--muted);margin-top:3px;}

  /* CHART */
  canvas{width:100%!important;background:#08040f;border:1px solid var(--border);display:block;}

  /* BREAKDOWN TABLE */
  .breakdown{width:100%;border-collapse:collapse;font-family:'Share Tech Mono',monospace;font-size:11px;margin-bottom:16px;}
  .breakdown th{background:#0d0815;color:var(--muted);font-size:9px;letter-spacing:2px;
    padding:8px 12px;text-align:left;border-bottom:1px solid var(--border);}
  .breakdown td{padding:9px 12px;border-bottom:1px solid var(--border2);vertical-align:top;}
  .tag{display:inline-block;font-size:10px;padding:2px 8px;border:1px solid;}
  .tag.g{color:var(--buy);border-color:#00e5a040;background:#00e5a010;}
  .tag.r{color:var(--sell);border-color:#ff3d6b40;background:#ff3d6b10;}
  .tag.y{color:var(--skip);border-color:#f0a50040;background:#f0a50010;}
  .tag.p{color:var(--block);border-color:#ff222240;background:#ff222210;}
  .tag.t{color:var(--trap);border-color:#ff2d5540;background:#ff2d5510;}

  /* SECOND TABLE */
  .sec-table-wrap{max-height:360px;overflow-y:auto;border:1px solid var(--border);}
  table.sec{width:100%;border-collapse:collapse;font-family:'Share Tech Mono',monospace;font-size:11px;}
  table.sec thead th{position:sticky;top:0;background:#0d0815;color:var(--muted);
    font-size:9px;letter-spacing:2px;padding:8px 10px;text-align:center;border-bottom:1px solid var(--border);}
  table.sec tbody td{padding:6px 10px;text-align:center;border-bottom:1px solid var(--border2);}
  table.sec tbody tr:hover td{background:#0d081590;}
  .pip-up{color:var(--buy);}
  .pip-dn{color:var(--sell);}
  .pip-flat{color:var(--muted);}
  .row-trap{background:#ff2d5508!important;}
  .row-spike{background:#ff3d6b08!important;}

  /* ALERTS */
  .alert-box{border-left:3px solid;padding:10px 14px;margin-bottom:8px;
    font-family:'Share Tech Mono',monospace;font-size:11px;line-height:1.7;background:#0a0614;}
  .alert-box.buy{border-color:var(--buy);color:var(--buy);}
  .alert-box.sell{border-color:var(--sell);color:var(--sell);}
  .alert-box.warn{border-color:var(--warn);color:var(--warn);}
  .alert-box.block{border-color:var(--block);color:var(--block);}
  .alert-box.trap{border-color:var(--trap);color:var(--trap);}
  .alert-box.info{border-color:var(--accent);color:var(--accent);}

  ::-webkit-scrollbar{width:5px;height:5px;}
  ::-webkit-scrollbar-track{background:var(--bg);}
  ::-webkit-scrollbar-thumb{background:var(--border);}
  ::-webkit-scrollbar-thumb:hover{background:var(--accent);}
</style>
</head>
<body>
<div class="wrap">

  <!-- HEADER -->
  <div class="header">
    <div>
      <div class="badge">⚡ EUR/USD OTC · WEEKEND ENGINE</div>
      <span class="weekend-tag">⚠ SYNTHETIC MARKET</span>
    </div>
    <h1>WEEKEND SIGNAL ENGINE <span>v1</span></h1>
