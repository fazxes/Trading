      </div>

      <!-- INPUT -->
      <div class="panel">
        <div class="ptitle">📋 PASTE 288 PRICES</div>
        <textarea class="bulk" id="raw-input"
          placeholder="Paste 288 prices — 1 per second.
Second 300 (candle open) → second 12 (last).

1.08500  ← sec 300
1.08501
1.08499
...
1.08541  ← sec 12

Bot stops at sec 12.
Signal fires at sec 7. Enter trade."></textarea>
        <div class="hint">
          ✅ 288 prices = sec 300 → sec 12<br>
          ✅ Weekend mode: stricter thresholds active<br>
          ✅ Manipulation score calculated on every candle
        </div>
        <button class="btn-main" onclick="runEngine()">⚡ CALCULATE WEEKEND SIGNAL</button>
        <button class="btn-sec" onclick="loadDemo()">LOAD DEMO DATA</button>
        <button class="btn-sec" onclick="clearAll()">CLEAR</button>
      </div>

      <!-- ALERTS -->
      <div id="alerts-wrap" style="display:none">
        <div class="panel">
          <div class="ptitle">⚠️ DETECTED EVENTS</div>
          <div id="alerts-list"></div>
        </div>
      </div>
    </div>

    <!-- RIGHT -->
    <div>

      <!-- BIG SIGNAL -->
      <div class="signal-mega" id="sig-mega">
        <div style="font-family:'Share Tech Mono',monospace;font-size:10px;color:var(--muted);letter-spacing:3px;margin-bottom:10px;">WEEKEND SIGNAL</div>
        <div class="signal-word" id="sig-word" style="color:var(--muted);">WAITING</div>
