      <!-- SCORE CARDS -->
      <div class="score-grid" id="score-grid">
        <div class="score-card"><div class="sc-label">CONFIDENCE SCORE</div><div class="sc-val" id="sc-total">—</div><div class="sc-note" id="sc-total-note">—</div></div>
