            <th>SEC</th><th>PRICE</th><th>PIP CHANGE</th><th>CUMULATIVE</th>
            <th>GAP</th><th>SPIKE</th><th>TRAP</th><th>ZIGZAG</th><th>FLAG</th>
          </tr></thead>
          <tbody id="sec-tbody"></tbody>
