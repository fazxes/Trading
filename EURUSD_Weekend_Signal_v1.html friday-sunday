function loadDemo() {
  const prices = [];
  let p = 1.08500;
  const trend = Math.random()>0.5?1:-1;
  for (let i=0;i<288;i++) {
    // Weekend: more chop, inject traps
    if (i===60) { // fake push up then reverse (trap)
      for(let j=0;j<10;j++){p+=0.00015;prices.push(p.toFixed(5));}
      for(let j=0;j<8;j++){p-=0.00018;prices.push(p.toFixed(5));}
      i+=17; continue;
    }
    p += trend*0.000008 + (Math.random()-0.49)*0.00007;
    if(i===150||i===220){p+=(Math.random()>0.5?1:-1)*0.00020;} // fake spikes
    if(i===151||i===221){p-=(Math.random()>0.5?1:-1)*0.00015;}
    prices.push(p.toFixed(5));
  }
  document.getElementById('raw-input').value = prices.slice(0,288).join('\n');
}

